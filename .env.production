# Production Environment Variables
# Copy to .env and fill in actual values

# MongoDB
MONGO_ROOT_PASSWORD=secure_root_password_here
MONGO_APP_PASSWORD=secure_app_password_here

# NextAuth
NEXTAUTH_SECRET=your-secret-key-min-32-chars-recommended
NEXTAUTH_URL=https://your-domain.com

# Next.js Public API URL (for frontend)
NEXT_PUBLIC_API_URL=https://your-domain.com

# Email (Resend)
RESEND_API_KEY=re_your_resend_key_here
RESEND_FROM_EMAIL=SHA <noreply@sha.co.zw>

# Mega.nz (file storage)
MEGA_EMAIL=your-mega-email@example.com
MEGA_PASSWORD=your-mega-password

# Optional: MongoDB Atlas (use this instead of local MongoDB if preferred)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sha

# Next.js
NODE_ENV=production
